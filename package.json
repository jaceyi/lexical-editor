{
  "name": "@jaceyi/lexical-editor",
  "version": "1.0.1",
  "description": "A React rich text editor based on Lexical, supporting HTML and JSON modes with extensible plugins.",
  "license": "MIT",
  "main": "lib/index.js",
  "type": "module",
  "typings": "lib/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaceyi/lexical-editor.git"
  },
  "homepage": "https://github.com/jaceyi/lexical-editor",
  "author": "Jace Yi <yijinchun@outlook.com>",
  "keywords": [
    "react",
    "editor",
    "lexical",
    "rich-text"
  ],
  "files": [
    "README.md",
    "LICENSE",
    "lib"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./style.css": "./lib/style.css"
  },
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "rm -rf ./lib && pnpm run build:ts && pnpm run build:style",
    "build:ts": "tsc",
    "build:style": "sass --no-source-map --style compressed src/index.scss lib/style.css && postcss --no-map lib/style.css --use=autoprefixer --output=lib/style.css",
    "watch": "chokidar \"src/**/*\" -c \"pnpm run build\"",
    "watch:ts": "chokidar \"src/**/*.{ts,tsx}\" -c \"pnpm run build:ts\"",
    "watch:style": "chokidar \"src/**/*.scss\" -c \"pnpm run build:style\"",
    "prettier": "prettier --write 'src/**/*.{ts,tsx,js,jsx,scss,css}'",
    "lint": "eslint 'src/**/*.{ts,tsx,js,jsx}' --quiet --fix"
  },
  "packageManager": "pnpm@11.20.0",
  "dependencies": {
    "@lexical/html": "^0.50.0",
    "@lexical/link": "^0.50.0",
    "@lexical/list": "^0.50.0",
    "@lexical/react": "^0.50.0",
    "@lexical/rich-text": "^0.50.0",
    "@lexical/selection": "^0.50.0",
    "@lexical/utils": "^0.50.0",
    "@rc-component/dropdown": "^2.0.0",
    "@rc-component/tooltip": "^1.5.2",
    "clsx": "^2.1.1",
    "lexical": "^0.50.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "@typescript-eslint/parser": "^7.11.0",
    "autoprefixer": "^10.4.19",
    "chokidar-cli": "^3.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "^8.4.38",
    "postcss-cli": "^11.0.0",
    "prettier": "^3.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sass": "^1.77.2",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}
